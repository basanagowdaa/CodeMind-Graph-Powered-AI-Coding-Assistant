# ─────────────────────────────────────────────
# CodeMind — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── HydraDB (required) ───────────────────────
# Get your key at https://app.hydradb.com
HYDRA_DB_API_KEY=your_hydradb_api_key_here

# ── LLM Provider (choose one) ────────────────
# Google Gemini (default)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Active LLM provider: "gemini" | "openai" | "anthropic"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# ── GitHub (optional — for private repos) ────
# Leave empty for public repositories
GITHUB_TOKEN=

# ── Backend ───────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Analysis limits (security) ───────────────
# Maximum repository size in MB
MAX_REPO_SIZE_MB=500
# Maximum number of files to analyze
MAX_FILES=2000
# Maximum file size in KB
MAX_FILE_SIZE_KB=500
# Temp directory for cloned repos
CLONE_DIR=./tmp/repos
